# ============================================================
#  Gatums Gourmet - Variaveis de ambiente (HOMOLOGACAO / Release)
#  Para importar no RENDER: servico > Environment > "Add from .env"
# ============================================================

# Ambiente: carrega appsettings.json + appsettings.Release.json
ASPNETCORE_ENVIRONMENT=Release

# Porta do Kestrel (o Render encaminha o trafego para esta porta)
ASPNETCORE_URLS=http://+:8080

# --- Banco: Neon (branch "homologacao") ---
# Formato Npgsql (NAO a URL postgresql:// do Neon). Use o host com -pooler.
#   postgresql://USER:PASS@HOST/DB?sslmode=require
#   -> Host=HOST;Database=DB;Username=USER;Password=PASS;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=Host=COLOQUE-O-HOST-POOLER.neon.tech;Database=COLOQUE-O-DB;Username=COLOQUE-O-USER;Password=COLOQUE-A-SENHA;SSL Mode=Require;Trust Server Certificate=true

# --- JWT (gere um secret de HML proprio, min 32 chars) ---
Jwt__Secret=COLOQUE-UM-SECRET-DE-HOMOLOGACAO-COM-MIN-32-CHARS
Jwt__Issuer=GatumsGourmet
Jwt__Audience=GatumsGourmet.Web
