# ============================================================
#  Gatums Gourmet — Variáveis de ambiente (PRODUÇÃO)
#  Copie para .env e preencha:  cp .env.example .env
#  NUNCA commite o arquivo .env
# ============================================================

# === Banco de Dados PostgreSQL ===
DB_USER=gatums
DB_PASSWORD=
# Gere uma senha segura: openssl rand -base64 24 | tr -d '/+=' | head -c 32
DB_NAME=gatums

# === JWT ===
JWT_SECRET=
# Gere uma chave segura (mín 32 chars): openssl rand -base64 48 | tr -d '/+=' | head -c 64
JWT_ISSUER=GatumsGourmet
JWT_AUDIENCE=GatumsGourmet.Web
