# ============================================================
#  Gatums Gourmet — Variáveis de ambiente para deploy (Render)
#  Guia completo: docs/Deploy-Render-HML.md
# ============================================================

# ── Ambiente ──
# Release = carrega appsettings.Release.json (Supabase Storage + CORS Vercel)
ASPNETCORE_ENVIRONMENT=Release

# ── PostgreSQL (Supabase ou Render Postgres) ──
# No Render, defina como variável de ambiente (sync=false no render.yaml):
# Formato: Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<pass>
ConnectionStrings__DefaultConnection=

# ── JWT ──
Jwt__Secret=
Jwt__Issuer=GatumsGourmet
Jwt__Audience=GatumsGourmet.Web

# ── Supabase Storage (S3-compatível) ──
# Pegar em: Supabase Dashboard → Settings → Storage → S3 Connection
# Os valores abaixo sobrescrevem appsettings.Release.json (que tem ServiceUrl,
# Bucket, PublicBaseUrl preenchidos; faltam apenas as credenciais)
Storage__AccessKey=
Storage__SecretKey=
# Storage__ServiceUrl=https://<project-ref>.supabase.co/storage/v1/s3
# Storage__Bucket=gatums-imagens
# Storage__Region=us-west-2
# Storage__ForcePathStyle=true
# Storage__PublicBaseUrl=https://<project-ref>.supabase.co/storage/v1/object/public/gatums-imagens

# ── CORS (opcional) ──
# Override do appsettings.Release.json. Padrão: https://gatums-gourmet*.vercel.app
# Cors__AllowedOriginPatterns__0=https://seu-dominio.com
