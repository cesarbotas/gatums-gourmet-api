    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "adminRefreshToken", "value": "", "type": "string" },
    { "key": "adminTokenExpiraEm", "value": "", "type": "string" },
    { "key": "clienteNome", "value": "Cliente Runner", "type": "string" },
    { "key": "clienteEmail", "value": "cliente.runner@exemplo.com", "type": "string" },
