    {
      "name": "Pedidos",
      "description": "Checkout (cliente), listagem/consulta (auth qualquer), avanço de etapa (auth qualquer), conclusão de pagamento (cliente).",
      "item": [
        {
          "name": "Checkout (carrinho → pedido)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checkout OK', () => pm.response.to.have.status(201));",
                  "var json = pm.response.json();",
                  "if (json.pedidoId) { pm.collectionVariables.set('pedidoId', json.pedidoId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{clienteToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteNome\": \"Cliente Exemplo\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Cria o pedido a partir do carrinho atual do usuário. Etapa inicial: criado.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pedidos", "checkout"]
            }
          },
          "response": []
        },
        {
          "name": "Listar Pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{clienteToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos?page=1&pageSize=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pedidos"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "10" }
              ]
            },
            "description": "Admin vê todos; cliente vê apenas os próprios (filtro automático por userId do token)."
          },
          "response": []
        },
        {
          "name": "Obter Pedido por Id",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{clienteToken}}", "type": "string" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pedidos", "{{pedidoId}}"]
            },
            "description": "Admin vê qualquer pedido; cliente não-admin recebe 400 se o pedido não for seu."
          },
          "response": []
        },
        {
          "name": "Avançar Etapa do Pedido",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proximaEtapa\": 1,\n  \"observacao\": \"Pedido confirmado\",\n  \"entregaTipo\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "proximaEtapa (int): 0=Criado, 1=Aprovado, 2=Pagamento, 3=PagamentoAprovado, 4=EnvioPendente, 5=Entregue, 6=Finalizado.\nentregaTipo (int): 0=Transporte, 1=Retirada. Necessário quando a etapa é Entregue.\nActor é derivado do role do token (admin → PedidoActor.Admin, cliente → PedidoActor.Cliente).",
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}/etapas/avancar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pedidos", "{{pedidoId}}", "etapas", "avancar"]
            }
          },
          "response": []
        },
        {
          "name": "Concluir Pagamento do Pedido (cliente)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{clienteToken}}", "type": "string" }]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transacaoId\": \"{{transacaoId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Vincula uma transação aprovada ao pedido. Use após POST /pagamentos/{transacaoId}/pix/confirmar ou /cartao.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/pedidos/{{pedidoId}}/pagamento/concluir",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pedidos", "{{pedidoId}}", "pagamento", "concluir"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Pagamentos",
      "description": "Fluxo de pagamento. ClienteOnly, exceto /validar (AdminOnly).",
      "item": [
        {
          "name": "Listar Opções de Pagamento (cliente)",
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{clienteToken}}", "type": "string" }]
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/pagamentos/opcoes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pagamentos", "opcoes"]
            },
            "description": "Retorna [{metodo:'cartao_credito',label:'Cartão de Crédito',disponivel:true}, ...]. ATENÇÃO: o campo 'metodo' aqui usa underscore, mas o body de /iniciar espera o enum MetodoPagamento como INTEIRO."
          },
          "response": []
        },
        {
          "name": "Iniciar Pagamento (cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pagamento iniciado', () => pm.response.to.have.status(201));",
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('transacaoId', json.id); }"
                ]
              }
            }
          ],
          "auth": {
            "type": "bearer",
            "bearer": [{ "key": "token", "value": "{{clienteToken}}", "type": "string" }]
          },
          "request": {
            "method": "POST",
