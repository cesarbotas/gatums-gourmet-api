            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pedidoId\": \"{{pedidoId}}\",\n  \"metodo\": 2,\n  \"valor\": 89.90\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "metodo (int): 0=CartaoDebito, 1=CartaoCredito, 2=Pix.\nSe já existe transação pendente para o pedido, retorna a existente.\nPara Pix, a resposta inclui pixCopiaCola e pixExpiraEm.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/pagamentos/iniciar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "pagamentos", "iniciar"]
            }
