                  "var json = pm.response.json();",
                  "pm.test('Tem accessToken e refreshToken', () => { pm.expect(json.accessToken).to.be.a('string').and.not.empty; pm.expect(json.refreshToken).to.be.a('string').and.not.empty; });",
